  triggerState: 0
  sentences:
  - dialogueCharacter: {fileID: 0}
    sentence: "H\xE9, qui va l\xE0? Vous cherchez quelque chose ?"
    skipDelayTime: 0
    sentenceSound: {fileID: 0}
    sentenceEvent:
      m_PersistentCalls:
        m_Calls: []
  - dialogueCharacter: {fileID: 0}
    sentence: "...La grande tour? Hum, si j'\xE9tais vous, je ne tenterais pas le
      coup, mais bon..."
    skipDelayTime: 0
    sentenceSound: {fileID: 0}
    sentenceEvent:
      m_PersistentCalls:
        m_Calls: []
  - dialogueCharacter: {fileID: 0}
    sentence: "Je n'ai pas beaucoup de renseignements \xE0 vous donner, je sais juste
      au'il y a un coffre quelque part ici qui contient une des cl\xE9s n\xE9cessaires."
    skipDelayTime: 0
    sentenceSound: {fileID: 0}
    sentenceEvent:
      m_PersistentCalls:
        m_Calls: []
  - dialogueCharacter: {fileID: 0}
    sentence: "Il y a aussi un renard qui traine dans le coin. Peut-\xEAtre qu'il
      saura vous aider... Ou vous nuire."
    skipDelayTime: 0
    sentenceSound: {fileID: 0}
    sentenceEvent:
      m_PersistentCalls:
        m_Calls: []
  - dialogueCharacter: {fileID: 0}
    sentence: Bonne chance...
    skipDelayTime: 0
    sentenceSound: {fileID: 0}
    sentenceEvent:
      m_PersistentCalls:
        m_Calls: []
